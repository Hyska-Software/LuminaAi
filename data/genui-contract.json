          "type": "text",
          "maxChars": 120
        }
      }
    },
    {
      "type": "link",
      "kind": "leaf",
      "category": "content",
      "summary": "External link that opens in the default browser.",
      "doc": "`href` (http(s)), `label` (≤ 80).",
      "acceptsChildren": false,
      "props": {
        "href": {
          "type": "url",
          "required": true
        },
        "label": {
          "type": "text",
          "required": true,
          "maxChars": 120
        }
      }
    },
    {
      "type": "actions",
      "kind": "leaf",
      "category": "interaction",
      "summary": "Row of suggested actions that fill the composer or copy text.",
      "doc": "`items` (1–4 `{label, prompt? OR copy?, tone? (`primary|secondary|ghost`), icon?}`), `align?` (`start|end`); `prompt` fills the composer.",
      "acceptsChildren": false,
      "props": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "item": {
              "type": "object",
              "props": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxChars": 60
                },
                "prompt": {
                  "type": "text",
                  "maxChars": 400
                },
                "copy": {
                  "type": "text",
                  "maxChars": 4000
                },
                "tone": {
                  "type": "enum",
                  "values": [
                    "primary",
                    "secondary",
                    "ghost"
                  ],
                  "default": "secondary"
                },
                "icon": {
                  "type": "icon"
                }
              }
            }
          }
        },
        "align": {
          "type": "enum",
          "values": [
            "start",
            "end"
          ],
          "default": "start"
        }
      }
    },
    {
      "type": "choices",
      "kind": "leaf",
      "category": "interaction",
      "summary": "Interactive options group (radio, checkbox or segmented) with a count and a submit that sends the selection to the composer.",
      "doc": "`options` (2–12 `{label, description?, icon?}`), `mode?` (`single|multiple`), `layout?` (`list|segmented`), `label?` (≤ 80), `default?` (pre-selected labels), `countLabel?` (≤ 60, e.g. \"Capacidades habilitadas\"), `submitLabel?` (≤ 40, e.g. \"Aplicar configuração\"), `submitPrefix?` (≤ 300). The interaction is local; submitting fills the composer with the prefix + selection — it never sends on its own.",
      "acceptsChildren": false,
      "props": {
        "label": {
          "type": "text",
          "maxChars": 80
        },
        "mode": {
          "type": "enum",
          "values": [
            "single",
            "multiple"
          ],
          "default": "single"
        },
        "layout": {
          "type": "enum",
          "values": [
            "list",
            "segmented"
          ],
          "default": "list"
        },
        "options": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "item": {
              "type": "object",
              "props": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxChars": 60
                },
                "description": {
                  "type": "text",
                  "maxChars": 160
                },
                "icon": {
                  "type": "icon"
                }
              }
            }
          }
        },
        "default": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "item": {
              "type": "text",
              "maxChars": 60
            }
          }
        },
        "countLabel": {
          "type": "text",
          "maxChars": 60
        },
        "submitLabel": {
          "type": "text",
          "maxChars": 40
        },
        "submitPrefix": {
          "type": "text",
          "maxChars": 300
        }
      }
    }
  ],
  "rules": [
    {
      "id": "ui.root-count",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "max": 4
      },
      "message": "A raiz tem componentes demais.",
      "hint": "Agrupe tudo em um `card` ou `stack` raiz e distribua o conteúdo dentro dele.",
      "prompt": "Group the content into 1 root `card`/`stack` (max. 4 root components)."
    },
    {
      "id": "ui.card-title",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Card de topo sem `title`: a hierarquia fica ambígua.",
      "hint": "Adicione um `title` curto ou use `stack`/`divider` se não for um cartão.",
      "prompt": "Every top-level `card` needs a `title`."
    },
    {
      "id": "ui.card-nested",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Card dentro de card duplica a hierarquia.",
      "hint": "Use `stack`, `divider` ou `callout` para separar seções internas.",
      "prompt": "Never nest `card` inside `card`."
    },
    {
      "id": "ui.callout-style",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Caixa de destaque colorida (`callout`) não faz parte do padrão do chat.",
      "hint": "Escreva notas e ressalvas em Markdown normal (texto ou citação); status curtos vão em `badge`. Não emita `callout`.",
      "prompt": "NEVER use `callout` (colored note box): caveats go in Markdown; status in `badge`."
    },
    {
      "id": "ui.cards-count",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "max": 4
      },
      "message": "Muitos cards no mesmo bloco.",
      "hint": "No máximo 4 cards; combine métricas em `grid` de `stat`.",
      "prompt": "At most 4 `card` per block."
    },
    {
      "id": "ui.grid-orphans",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "O número de filhos do `grid` não completa as colunas.",
      "hint": "Ajuste `columns` ou o número de filhos para fechar as linhas.",
      "prompt": "In `grid`, the number of children must fill the columns."
    },
    {
      "id": "ui.grid-crowded",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "factor": 3
      },
      "message": "Grid com muitos filhos por linha.",
      "hint": "Divida em mais de um grid ou reduza o conteúdo.",
      "prompt": "At most 3 children per column in `grid`."
    },
    {
      "id": "ui.divider-count",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "max": 2
      },
      "message": "Divisores demais fragmentam o conteúdo.",
      "hint": "Prefira espaçamento entre grupos a divisores.",
      "prompt": "Use at most 2 `divider`."
    },
    {
      "id": "ui.empty-container",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Container sem filhos não tem conteúdo.",
      "hint": "Remova o container vazio ou adicione filhos.",
      "prompt": "Do not emit empty containers."
    },
    {
      "id": "ui.chart-title",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "message": "Gráfico sem `title`.",
      "hint": "O título deve dizer a métrica e a unidade.",
      "prompt": "Every `chart` needs a `title`."
    },
    {
      "id": "ui.chart-points-min",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "min": 2
      },
      "message": "Gráfico com menos de 2 pontos.",
      "hint": "Para um valor único use `stat`; `chart` é para séries.",
      "prompt": "`chart` needs 2+ points; a single value goes in `stat`."
    },
    {
      "id": "ui.chart-pie-slices",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 7
      },
      "message": "Gráfico de pizza com fatias demais fica ilegível.",
      "hint": "Agrupe categorias menores em \"Outros\" ou use barras.",
      "prompt": "Pie: at most 7 slices."
    },
    {
      "id": "ui.table-columns",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 8
      },
      "message": "Tabela com muitas colunas.",
      "hint": "Mostre as colunas essenciais; o restante pode virar artefato CSV.",
      "prompt": "Table: at most 8 columns."
    },
    {
      "id": "ui.table-arity",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "message": "Há linha com número de células diferente das colunas.",
      "hint": "Cada linha deve ter exatamente uma célula por coluna.",
      "prompt": "Each table row must have the same number of cells as the columns."
    },
    {
      "id": "ui.stat-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "message": "Métrica com texto longo demais.",
      "hint": "Mantenha `label` ≤ 32, `value` ≤ 20 e `hint` ≤ 100 caracteres.",
      "prompt": "`stat`: label ≤ 32, value ≤ 20, hint ≤ 100.",
      "params": {
        "label": 32,
        "value": 20,
        "hint": 100
      }
    },
    {
      "id": "ui.list-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 20
      },
      "message": "Lista muito longa.",
      "hint": "Divida em seções ou use `table`.",
      "prompt": "`list`: at most 20 items."
    },
    {
      "id": "ui.timeline-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 12
      },
      "message": "Linha do tempo muito longa.",
      "hint": "Mostre os eventos principais; o restante pode virar texto.",
      "prompt": "`timeline`: at most 12 items."
    },
    {
      "id": "ui.steps-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 10
      },
      "message": "Passos demais para uma UI compacta.",
      "hint": "Agrupe etapas ou use `timeline`.",
      "prompt": "`steps`: at most 10 items."
    },
    {
      "id": "ui.keyvalue-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 12
      },
      "message": "Muitos pares chave/valor.",
      "hint": "Use `table` quando passar de 12 linhas.",
      "prompt": "`keyvalue`: at most 12 pairs."
    },
    {
      "id": "ui.tabs-count",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 6
      },
      "message": "Abas demais.",
      "hint": "Mantenha de 2 a 4 abas com objetivos distintos.",
      "prompt": "`tabs`: at most 6 tabs (2–4 ideal)."
    },
    {
      "id": "ui.density",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "nodes": 60,
        "depth": 6
      },
      "message": "UI densa demais para uma mensagem de chat.",
      "hint": "Reduza ao essencial; conteúdo longo pertence ao Markdown ou a um artefato.",
      "prompt": "Compact UI: ~60 components and at most 6 levels."
    },
    {
      "id": "ui.markdown-in-props",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Há sintaxe Markdown dentro de props (não é renderizada).",
      "hint": "Props são texto puro; use Markdown só fora do bloco `ui`.",
      "prompt": "Props are plain text: no `**`, `#` or Markdown links inside the block."
    },
    {
      "id": "ui.emoji",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Emoji decorativo em título/rótulo de UI.",
      "hint": "Emojis só quando o conteúdo do usuário os trouxer.",
      "prompt": "No decorative emojis in titles/labels."
    },
    {
      "id": "ui.label-period",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Rótulo terminando com ponto final.",
      "hint": "Rótulos curtos vão sem pontuação final.",
      "prompt": "No trailing period in labels and buttons."
