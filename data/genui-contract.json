          "type": "boolean",
          "default": false
        }
      }
    },
    {
      "type": "code",
      "kind": "leaf",
      "category": "content",
      "summary": "Code block with syntax highlighting and a copy button.",
      "doc": "`code` (up to 20,000 chars), `language?`, `title?` (file name).",
      "acceptsChildren": false,
      "props": {
        "code": {
          "type": "text",
          "required": true,
