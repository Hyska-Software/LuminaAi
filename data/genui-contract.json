                },
                "tone": {
                  "type": "enum",
                  "values": [
                    "primary",
                    "secondary",
                    "ghost"
                  ],
                  "default": "secondary"
                },
                "icon": {
                  "type": "icon"
                }
              }
            }
          }
        },
        "align": {
          "type": "enum",
          "values": [
            "start",
            "end"
          ],
          "default": "start"
        }
      }
    },
    {
      "type": "choices",
      "kind": "leaf",
      "category": "interaction",
      "summary": "Grupo de opções interativo (rádio, checkbox ou segmentado) com contagem e envio da seleção ao composer.",
      "doc": "`options` (2–12 `{label, description?, icon?}`), `mode?` (`single|multiple`), `layout?` (`list|segmented`), `label?` (≤ 80), `default?` (labels pré-selecionadas), `countLabel?` (≤ 60, ex.: \"Capacidades habilitadas\"), `submitLabel?` (≤ 40, ex.: \"Aplicar configuração\"), `submitPrefix?` (≤ 300). A interação é local; o envio preenche o composer com o prefixo + seleção — nunca envia sozinho.",
      "acceptsChildren": false,
      "props": {
        "label": {
          "type": "text",
          "maxChars": 80
        },
        "mode": {
          "type": "enum",
          "values": [
            "single",
            "multiple"
          ],
          "default": "single"
        },
        "layout": {
          "type": "enum",
          "values": [
            "list",
            "segmented"
          ],
          "default": "list"
        },
        "options": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "item": {
              "type": "object",
              "props": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxChars": 60
                },
                "description": {
                  "type": "text",
                  "maxChars": 160
                },
                "icon": {
                  "type": "icon"
                }
              }
            }
          }
        },
        "default": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "item": {
              "type": "text",
              "maxChars": 60
            }
          }
        },
        "countLabel": {
          "type": "text",
          "maxChars": 60
        },
        "submitLabel": {
          "type": "text",
          "maxChars": 40
        },
        "submitPrefix": {
          "type": "text",
          "maxChars": 300
        }
      }
    }
  ],
  "rules": [
    {
      "id": "ui.root-count",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "max": 4
      },
      "message": "A raiz tem componentes demais.",
      "hint": "Agrupe tudo em um `card` ou `stack` raiz e distribua o conteúdo dentro dele.",
      "prompt": "Agrupe o conteúdo em 1 `card`/`stack` raiz (máx. 4 componentes raiz)."
    },
    {
      "id": "ui.card-title",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Card de topo sem `title`: a hierarquia fica ambígua.",
      "hint": "Adicione um `title` curto ou use `stack`/`divider` se não for um cartão.",
      "prompt": "Todo `card` de topo precisa de `title`."
    },
    {
      "id": "ui.card-nested",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Card dentro de card duplica a hierarquia.",
      "hint": "Use `stack`, `divider` ou `callout` para separar seções internas.",
      "prompt": "Nunca aninhe `card` dentro de `card`."
    },
    {
      "id": "ui.callout-style",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Caixa de destaque colorida (`callout`) não faz parte do padrão do chat.",
      "hint": "Escreva notas e ressalvas em Markdown normal (texto ou citação); status curtos vão em `badge`. Não emita `callout`.",
      "prompt": "NUNCA use `callout` (caixa colorida de nota): ressalvas vão em Markdown; status em `badge`."
    },
    {
      "id": "ui.cards-count",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "max": 4
      },
      "message": "Muitos cards no mesmo bloco.",
      "hint": "No máximo 4 cards; combine métricas em `grid` de `stat`.",
      "prompt": "Máximo 4 `card` por bloco."
    },
    {
      "id": "ui.grid-orphans",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "O número de filhos do `grid` não completa as colunas.",
      "hint": "Ajuste `columns` ou o número de filhos para fechar as linhas.",
      "prompt": "Em `grid`, o número de filhos deve completar as colunas."
    },
    {
      "id": "ui.grid-crowded",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "factor": 3
      },
      "message": "Grid com muitos filhos por linha.",
      "hint": "Divida em mais de um grid ou reduza o conteúdo.",
      "prompt": "No máximo 3 filhos por coluna em `grid`."
    },
    {
      "id": "ui.divider-count",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "params": {
        "max": 2
      },
      "message": "Divisores demais fragmentam o conteúdo.",
      "hint": "Prefira espaçamento entre grupos a divisores.",
      "prompt": "Use no máximo 2 `divider`."
    },
    {
      "id": "ui.empty-container",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Container sem filhos não tem conteúdo.",
      "hint": "Remova o container vazio ou adicione filhos.",
      "prompt": "Não emita containers vazios."
    },
    {
      "id": "ui.chart-title",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "message": "Gráfico sem `title`.",
      "hint": "O título deve dizer a métrica e a unidade.",
      "prompt": "Todo `chart` precisa de `title`."
    },
    {
      "id": "ui.chart-points-min",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "min": 2
      },
      "message": "Gráfico com menos de 2 pontos.",
      "hint": "Para um valor único use `stat`; `chart` é para séries.",
      "prompt": "`chart` precisa de 2+ pontos; valor único vai em `stat`."
    },
    {
      "id": "ui.chart-pie-slices",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 7
      },
      "message": "Gráfico de pizza com fatias demais fica ilegível.",
      "hint": "Agrupe categorias menores em \"Outros\" ou use barras.",
      "prompt": "Pizza: no máximo 7 fatias."
    },
    {
      "id": "ui.table-columns",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 8
      },
      "message": "Tabela com muitas colunas.",
      "hint": "Mostre as colunas essenciais; o restante pode virar artefato CSV.",
      "prompt": "Tabela: no máximo 8 colunas."
    },
    {
      "id": "ui.table-arity",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "message": "Há linha com número de células diferente das colunas.",
      "hint": "Cada linha deve ter exatamente uma célula por coluna.",
      "prompt": "Cada linha da tabela deve ter o mesmo número de colunas."
    },
    {
      "id": "ui.stat-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "message": "Métrica com texto longo demais.",
      "hint": "Mantenha `label` ≤ 32, `value` ≤ 20 e `hint` ≤ 100 caracteres.",
      "prompt": "`stat`: label ≤ 32, value ≤ 20, hint ≤ 100.",
      "params": {
        "label": 32,
        "value": 20,
        "hint": 100
      }
    },
    {
      "id": "ui.list-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 20
      },
      "message": "Lista muito longa.",
      "hint": "Divida em seções ou use `table`.",
      "prompt": "`list`: no máximo 20 itens."
    },
    {
      "id": "ui.timeline-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 12
      },
      "message": "Linha do tempo muito longa.",
      "hint": "Mostre os eventos principais; o restante pode virar texto.",
      "prompt": "`timeline`: no máximo 12 itens."
    },
    {
      "id": "ui.steps-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 10
      },
      "message": "Passos demais para uma UI compacta.",
      "hint": "Agrupe etapas ou use `timeline`.",
      "prompt": "`steps`: no máximo 10 itens."
    },
    {
      "id": "ui.keyvalue-long",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 12
      },
      "message": "Muitos pares chave/valor.",
      "hint": "Use `table` quando passar de 12 linhas.",
      "prompt": "`keyvalue`: no máximo 12 pares."
    },
    {
      "id": "ui.tabs-count",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "max": 6
      },
      "message": "Abas demais.",
      "hint": "Mantenha de 2 a 4 abas com objetivos distintos.",
      "prompt": "`tabs`: no máximo 6 abas (ideal 2–4)."
    },
    {
      "id": "ui.density",
      "severity": "warning",
      "scope": "block",
      "category": "data",
      "params": {
        "nodes": 60,
        "depth": 6
      },
      "message": "UI densa demais para uma mensagem de chat.",
      "hint": "Reduza ao essencial; conteúdo longo pertence ao Markdown ou a um artefato.",
      "prompt": "UI compacta: ~60 componentes e 6 níveis no máximo."
    },
    {
      "id": "ui.markdown-in-props",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Há sintaxe Markdown dentro de props (não é renderizada).",
      "hint": "Props são texto puro; use Markdown só fora do bloco `ui`.",
      "prompt": "Props são texto puro: nada de `**`, `#` ou links Markdown dentro do bloco."
    },
    {
      "id": "ui.emoji",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Emoji decorativo em título/rótulo de UI.",
      "hint": "Emojis só quando o conteúdo do usuário os trouxer.",
      "prompt": "Sem emojis decorativos em títulos/rótulos."
    },
    {
      "id": "ui.label-period",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Rótulo terminando com ponto final.",
      "hint": "Rótulos curtos vão sem pontuação final.",
      "prompt": "Sem ponto final em rótulos e botões."
    },
    {
      "id": "ui.shouting",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Texto em caixa alta demais.",
      "hint": "Use capitalização normal (sentence case).",
      "prompt": "Sem CAIXA ALTA em rótulos."
    },
    {
      "id": "ui.duplicate-action",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "message": "Ações repetidas no mesmo bloco.",
      "hint": "Cada ação deve ter um objetivo distinto.",
      "prompt": "Ações com rótulos distintos."
    },
    {
      "id": "ui.action-primary",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "message": "Mais de uma ação primária.",
      "hint": "Só uma ação principal; as demais ficam `secondary` ou `ghost`.",
      "prompt": "No máximo 1 ação `primary` por bloco."
    },
    {
      "id": "ui.action-label-long",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "params": {
        "max": 40
      },
      "message": "Rótulo de ação longo.",
      "hint": "Use verbo + objeto curto (ex.: \"Comparar custos\").",
      "prompt": "Rótulos de `actions`: verbo + objeto, ≤ 40 chars."
    },
    {
      "id": "ui.section-header",
      "severity": "warning",
      "scope": "block",
      "category": "structure",
      "message": "Seção sem cabeçalho não agrega hierarquia.",
      "hint": "Informe `title` (ou `eyebrow`) na `section`, ou use um `stack` se não houver título.",
      "prompt": "Toda `section` precisa de `title` ou `eyebrow`."
    },
    {
      "id": "ui.choices-submit",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "message": "Grupo de escolhas sem ação de envio.",
      "hint": "Defina `submitLabel` para o usuário enviar a seleção ao agente (o clique preenche o composer).",
      "prompt": "Toda `choices` precisa de `submitLabel`."
    }
  ],
  "promptIntro": "Você pode renderizar interfaces declarativas na conversa usando um bloco cercado com a linguagem `ui` e um objeto JSON. A interface valida o JSON e desenha apenas componentes da whitelist — nada de HTML, JS ou CSS arbitrário."
}
