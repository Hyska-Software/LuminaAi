        }
      }
    },
    {
      "type": "source",
      "kind": "leaf",
      "category": "content",
      "summary": "External source/link chip with the site name.",
      "doc": "`label` (domain/site, ≤ 80), `href` (http(s)), `title?` (≤ 120) — opens in the default browser; use in a `stack` with `direction: row` (and `wrap`) for source lists.",
      "acceptsChildren": false,
      "props": {
        "label": {
          "type": "text",
          "required": true,
          "maxChars": 80
        },
