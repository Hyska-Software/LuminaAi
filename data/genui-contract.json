      "kind": "leaf",
      "category": "content",
      "summary": "Short status label.",
      "doc": "`label` (≤ 24), `tone?` (`neutral|accent|success|warning|danger|outline`), `icon?`.",
      "acceptsChildren": false,
      "props": {
        "label": {
          "type": "text",
          "required": true,
          "maxChars": 40
        },
        "tone": {
          "type": "enum",
          "values": [
            "neutral",
            "accent",
            "success",
            "warning",
            "danger",
