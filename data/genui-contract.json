    {
      "id": "ui.action-label-long",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "params": {
        "max": 40
      },
      "message": "Rótulo de ação longo.",
      "hint": "Use verbo + objeto curto (ex.: \"Comparar custos\").",
      "prompt": "`actions` labels: verb + object, ≤ 40 chars."
