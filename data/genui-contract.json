          "type": "icon"
        }
      }
    },
    {
      "type": "image",
      "kind": "leaf",
      "category": "content",
      "summary": "Remote image or data URI with a caption.",
      "doc": "`src` (http(s) or data:image/png|jpeg|webp|gif), `alt` (required, ≤ 160), `caption?` (≤ 160), `size?` (`full|thumb|avatar`), `aspect?` (`auto|video|square|wide`). In a `stack` with `direction: row`, use `size: thumb` for thumbnails.",
      "acceptsChildren": false,
      "props": {
        "src": {
          "type": "imageSrc",
          "required": true
        },
        "alt": {
          "type": "text",
          "required": true,
          "maxChars": 300
        },
        "caption": {
          "type": "text",
          "maxChars": 200
        },
        "size": {
          "type": "enum",
          "values": [
            "full",
