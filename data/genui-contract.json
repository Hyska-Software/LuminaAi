    {
      "id": "ui.shouting",
      "severity": "warning",
      "scope": "block",
      "category": "copy",
      "message": "Texto em caixa alta demais.",
      "hint": "Use capitalização normal (sentence case).",
      "prompt": "No ALL CAPS in labels."
    },
    {
      "id": "ui.duplicate-action",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "message": "Ações repetidas no mesmo bloco.",
      "hint": "Cada ação deve ter um objetivo distinto.",
      "prompt": "Actions with distinct labels."
    },
    {
      "id": "ui.action-primary",
      "severity": "warning",
      "scope": "block",
      "category": "interaction",
      "message": "Mais de uma ação primária.",
      "hint": "Só uma ação principal; as demais ficam `secondary` ou `ghost`.",
      "prompt": "At most 1 `primary` action per block."
