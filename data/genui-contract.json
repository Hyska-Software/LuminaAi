{
  "version": 2,
  "name": "Lumina Generative UI",
  "description": "Contrato único da UI generativa declarativa (blocos ```ui). É consumido pelo system prompt (Rust), pelo validador/ferramenta do agente (Rust) e pelo renderer (TypeScript). Alterar este arquivo exige atualizar a implementação dos dois lados — os testes de paridade (data/genui-fixtures.json) garantem que isso aconteça.",
  "format": {
    "root": "JSON object { \"version\"?: 2, \"components\": [...] }; a bare array of components is also accepted (normalized).",
    "version": 2,
    "notes": [
      "Each component is { \"type\": string, \"props\"?: object, \"children\"?: array }.",
      "`children` is only accepted on containers (card, stack, grid, tabs, reveal, callout).",
      "Maximum depth of 8 levels and at most 120 components per block.",
      "Unknown properties are ignored with a warning; prop names are exactly the ones in the contract.",
      "Legacy shapes are normalized: chart with `labels`+`values`, keyvalue as an object, list/steps items as strings.",
      "Plain text: Markdown is not rendered inside props; no HTML/JS/CSS.",
      "URLs in image.src/link.href must be http(s); image.src also accepts data:image/png|jpeg|webp|gif."
    ]
  },
  "blocks": {
    "maxPerMessage": 2,
    "recommendedPerMessage": 1
  },
  "limits": {
    "sourceChars": 200000,
    "depth": 8,
    "nodes": 120,
    "props": 24,
    "arrayItems": 200,
    "stringChars": 4000,
    "diagnosticsPerCode": 3
  },
  "icons": [
    "arrow-right",
    "calendar",
    "check",
    "chevron-right",
    "clock",
    "copy",
    "download",
    "external-link",
    "file-text",
    "globe",
    "lightbulb",
    "list-checks",
    "plus",
    "refresh-cw",
    "search",
    "sparkles",
    "atom",
    "book-open",
    "database",
    "flame",
    "layers",
    "settings",
    "shield-check",
    "target",
    "wrench"
  ],
  "interactions": {
    "description": "Interactive components are declarative and safe: no agent code is executed.",
    "actionKinds": [
      {
        "kind": "prompt",
        "label": "Suggest a question",
        "description": "Fills the composer with the action text; the user reviews it and sends when ready.",
        "maxChars": 400
      },
      {
        "kind": "copy",
        "label": "Copy",
        "description": "Copies the text to the user's clipboard.",
        "maxChars": 4000
      }
    ],
    "rules": [
      "Use `actions` to offer 1–4 concrete next steps after delivering the answer.",
      "Action labels: verb + short object (e.g. \"Comparar cenários\"), no trailing period.",
      "`prompt` actions fill the composer — they never send a message on their own.",
      "At most one `primary` action per group; the others are `secondary` or `ghost`.",
      "Do not use `actions` when the answer already ends with a simple question or when there is no useful next step."
    ]
  },
  "components": [
    {
      "type": "card",
      "kind": "container",
      "category": "layout",
      "summary": "Surface with a title/subtitle/footer/icon that groups one unit of content.",
      "doc": "`title?` (≤ 80), `subtitle?` (≤ 160), `footer?` (≤ 120), `variant?` (`default|accent|muted`), `icon?`; accepts `children`.",
      "acceptsChildren": true,
      "props": {
        "title": {
          "type": "text",
          "maxChars": 120
        },
        "subtitle": {
          "type": "text",
          "maxChars": 240
        },
        "footer": {
          "type": "text",
          "maxChars": 200
        },
        "variant": {
          "type": "enum",
          "values": [
            "default",
            "accent",
            "muted"
          ],
          "default": "default"
        },
        "icon": {
          "type": "icon"
        }
      }
    },
    {
      "type": "stack",
      "kind": "container",
      "category": "layout",
      "summary": "Flex container for stacking or aligning components.",
      "doc": "`direction?` (`column|row`), `gap?` (`none|sm|md|lg`), `align?` (`start|center|end|stretch`), `justify?` (`start|center|between|end`), `wrap?` (boolean); accepts `children`.",
      "acceptsChildren": true,
      "props": {
        "direction": {
          "type": "enum",
          "values": [
            "column",
            "row"
          ],
          "default": "column"
        },
        "gap": {
          "type": "enum",
          "values": [
            "none",
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        "align": {
          "type": "enum",
          "values": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch"
        },
        "justify": {
          "type": "enum",
          "values": [
            "start",
            "center",
            "between",
            "end"
          ],
          "default": "start"
        },
        "wrap": {
          "type": "boolean",
          "default": false
        }
      }
    },
    {
      "type": "grid",
      "kind": "container",
      "category": "layout",
      "summary": "Responsive grid for metrics and cards side by side.",
      "doc": "`columns?` (1–4, default 2), `gap?` (`none|sm|md|lg`); accepts `children`; the number of children must fill the columns.",
      "acceptsChildren": true,
      "props": {
        "columns": {
          "type": "number",
          "min": 1,
          "max": 4,
          "default": 2
        },
        "gap": {
          "type": "enum",
          "values": [
            "none",
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        }
      }
    },
    {
      "type": "tabs",
      "kind": "container",
      "category": "layout",
      "summary": "Tabs for switching between views of the same subject.",
      "doc": "Accepts `children` with 1 panel per tab; each panel needs `props.label` with the tab name (≤ 40 recommended; hard limit 80).",
      "acceptsChildren": true,
      "props": {
        "label": {
          "type": "text",
          "maxChars": 80,
          "required": false
        }
      }
    },
    {
      "type": "reveal",
      "kind": "container",
      "category": "layout",
      "summary": "Collapsible section for details that do not need to take up space.",
      "doc": "`title` (required, ≤ 80), `open?` (boolean, default false); accepts `children`.",
      "acceptsChildren": true,
      "props": {
        "title": {
          "type": "text",
          "maxChars": 120,
          "required": true
        },
        "open": {
          "type": "boolean",
          "default": false
        }
      }
    },
    {
      "type": "section",
      "kind": "container",
      "category": "layout",
      "summary": "Section header (eyebrow, title, icon, description and divider) with content below — no card frame.",
      "doc": "`title?` (≤ 100), `eyebrow?` (≤ 40), `description?` (≤ 200), `icon?`, `divider?`; accepts `children`. Use for news feeds, numbered lists and themed blocks.",
      "acceptsChildren": true,
      "props": {
        "title": {
          "type": "text",
          "maxChars": 100
        },
        "eyebrow": {
          "type": "text",
          "maxChars": 40
        },
        "description": {
          "type": "text",
          "maxChars": 200
        },
        "icon": {
          "type": "icon"
        },
        "divider": {
          "type": "boolean",
          "default": false
        }
      }
    },
    {
      "type": "divider",
      "kind": "leaf",
      "category": "layout",
      "summary": "Horizontal separator with an optional label.",
      "doc": "`label?` (≤ 40).",
      "acceptsChildren": false,
      "props": {
        "label": {
          "type": "text",
          "maxChars": 60
        }
      }
    },
    {
      "type": "table",
      "kind": "leaf",
      "category": "data",
      "summary": "Compact data table with a fixed header.",
      "doc": "`columns` (2–10 strings, ≤ 60 chars), `rows` (1–200 arrays of cells), `caption?` (≤ 160).",
      "acceptsChildren": false,
      "props": {
        "columns": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "item": {
              "type": "text",
              "maxChars": 80
            }
          }
        },
        "rows": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "item": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "item": {
                "type": "scalar"
              }
            }
          }
        },
        "caption": {
          "type": "text",
          "maxChars": 200
        }
      }
    },
    {
      "type": "chart",
      "kind": "leaf",
      "category": "data",
      "summary": "SVG bar, line or pie chart for numeric series.",
      "doc": "`type` (`bar|line|pie`), `data` (2–60 `{label, value}`), `title` (recommended: metric + unit, ≤ 80), `suffix?` (unit, ≤ 12).",
      "acceptsChildren": false,
      "props": {
        "type": {
          "type": "enum",
          "required": true,
          "values": [
            "bar",
            "line",
            "pie"
          ]
        },
        "data": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "item": {
              "type": "object",
              "props": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxChars": 80
                },
                "value": {
                  "type": "number",
                  "required": true
                }
              }
            }
          }
        },
        "title": {
          "type": "text",
          "maxChars": 120
        },
        "suffix": {
          "type": "text",
          "maxChars": 24
        }
      }
    },
    {
      "type": "stat",
      "kind": "leaf",
      "category": "data",
      "summary": "Single metric with label, value and trend.",
      "doc": "`label` (≤ 32), `value` (≤ 20), `trend?` (`up|down|flat`), `hint?` (≤ 100).",
      "acceptsChildren": false,
      "props": {
        "label": {
          "type": "text",
          "required": true,
          "maxChars": 60
        },
        "value": {
          "type": "text",
          "required": true,
          "maxChars": 32
        },
        "trend": {
          "type": "enum",
          "values": [
            "up",
            "down",
            "flat"
          ]
        },
        "hint": {
          "type": "text",
          "maxChars": 200
        }
      }
    },
    {
      "type": "progress",
      "kind": "leaf",
      "category": "data",
      "summary": "Progress bar for a completed fraction.",
      "doc": "`value` (0–`max`), `max?` (default 100), `label?` (≤ 60), `suffix?` (≤ 12).",
      "acceptsChildren": false,
      "props": {
        "value": {
          "type": "number",
          "required": true,
          "min": 0,
          "max": 1000000
        },
        "max": {
          "type": "number",
          "min": 1,
          "max": 1000000,
          "default": 100
        },
        "label": {
          "type": "text",
          "maxChars": 100
        },
        "suffix": {
          "type": "text",
          "maxChars": 24
        }
      }
    },
    {
      "type": "timeline",
      "kind": "leaf",
      "category": "data",
      "summary": "Timeline of events with status.",
      "doc": "`items` (2–20 `{title, time?, description?, status?}`; status `done|active|pending|error`).",
      "acceptsChildren": false,
      "props": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "item": {
              "type": "object",
              "props": {
                "title": {
                  "type": "text",
                  "required": true,
                  "maxChars": 120
                },
                "time": {
                  "type": "text",
                  "maxChars": 32
                },
                "description": {
                  "type": "text",
                  "maxChars": 240
                },
                "status": {
                  "type": "enum",
                  "values": [
                    "done",
                    "active",
                    "pending",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "steps",
      "kind": "leaf",
      "category": "data",
      "summary": "Numbered steps with the current step highlighted.",
      "doc": "`items` (2–16 `{title, description?}`), `current?` (1-based index of the current step; 0 = none). Keep `description` short; long traces, formulas and settings go in `table`/`code`.",
      "acceptsChildren": false,
      "props": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "item": {
              "type": "object",
              "props": {
                "title": {
                  "type": "text",
                  "required": true,
                  "maxChars": 120
                },
                "description": {
                  "type": "text",
                  "maxChars": 240
                }
              }
            }
          }
        },
        "current": {
          "type": "number",
          "min": 0,
          "max": 1000,
          "default": 0
        }
      }
    },
    {
      "type": "checklist",
      "kind": "leaf",
      "category": "data",
      "summary": "List with an icon/state per item (simulations, stages, capabilities).",
      "doc": "`items` (1–20 `{label, description?, status? (`done|active|pending|disabled|error`), icon?}`). Use for simulations and stages with status.",
      "acceptsChildren": false,
      "props": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "item": {
              "type": "object",
              "props": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxChars": 120
                },
                "description": {
                  "type": "text",
                  "maxChars": 200
                },
                "status": {
                  "type": "enum",
                  "values": [
                    "done",
                    "active",
                    "pending",
                    "disabled",
                    "error"
                  ]
                },
                "icon": {
                  "type": "icon"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "keyvalue",
      "kind": "leaf",
      "category": "data",
      "summary": "Label/value pairs for short specifications.",
      "doc": "`items` (1–20 `{label, value}`) — for many rows use `table`.",
      "acceptsChildren": false,
      "props": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "item": {
              "type": "object",
              "props": {
                "label": {
                  "type": "text",
                  "required": true,
                  "maxChars": 60
                },
                "value": {
                  "type": "text",
                  "required": true,
                  "maxChars": 200
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "list",
      "kind": "leaf",
      "category": "data",
      "summary": "Bulleted or numbered list with optional descriptions.",
      "doc": "`items` (1–40 strings or `{text, description?, href?, icon?, status?}`), `ordered?` (boolean). With `href`, the item becomes an external link.",
      "acceptsChildren": false,
      "props": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "item": {
              "type": "object",
              "props": {
                "text": {
                  "type": "text",
                  "required": true,
                  "maxChars": 400
                },
                "description": {
                  "type": "text",
                  "maxChars": 400
                },
                "href": {
                  "type": "url"
                },
                "icon": {
                  "type": "icon"
                },
                "status": {
                  "type": "enum",
                  "values": [
                    "done",
                    "active",
                    "pending",
                    "disabled",
                    "error"
                  ]
                }
              }
            }
          }
