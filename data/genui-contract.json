          "type": "text",
          "maxChars": 120
        }
      }
    },
    {
      "type": "quote",
      "kind": "leaf",
      "category": "content",
      "summary": "Short quote with attribution.",
      "doc": "`text` (≤ 600), `cite?` (≤ 120).",
      "acceptsChildren": false,
      "props": {
        "text": {
          "type": "text",
          "required": true,
          "maxChars": 1000
        },
        "cite": {
          "type": "text",
          "maxChars": 200
        }
      }
    },
    {
      "type": "text",
      "kind": "leaf",
      "category": "content",
      "summary": "Plain text paragraph inside the generative UI.",
      "doc": "`text` (required, ≤ 1200), `variant?` (`body|muted|lead|strong|small`). Plain text: Markdown is not rendered inside props.",
      "acceptsChildren": false,
      "props": {
        "text": {
          "type": "text",
          "required": true,
          "maxChars": 1200
        },
        "variant": {
          "type": "enum",
          "values": [
            "body",
            "muted",
            "lead",
            "strong",
            "small"
          ],
          "default": "body"
        }
      }
    },
    {
      "type": "callout",
      "kind": "container",
      "category": "content",
      "summary": "Colored info/warning highlight — DEPRECATED: do not emit in new responses.",
      "doc": "DO NOT EMIT in new responses: `callout` (colored note box) was deprecated. Notes/caveats go in plain Markdown; short statuses in `badge`. Kept only to render old messages (`variant?`, `title?`, `text?`, optional children).",
      "acceptsChildren": true,
      "props": {
        "variant": {
          "type": "enum",
          "values": [
            "info",
            "warning",
            "success",
            "danger"
