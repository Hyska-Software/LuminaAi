{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina",
  "version": "0.3.6",
  "identifier": "app.lumina.chat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:fast",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumina",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Chat desktop com harness de agentes",
    "longDescription": "Lumina é um aplicativo de chat com LLMs (OpenCode Go e Zen), com busca na web, análise de documentos, criação de arquivos e componentes generativos na conversa."
  }
}
