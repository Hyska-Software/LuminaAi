{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "installer",
  "description": "Minimal permissions for the Zylara setup window",
  "windows": ["setup"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-open",
    "opener:default"
  ]
}
